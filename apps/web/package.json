{
  "name": "patchpilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api-schema.d.ts"
  },
  "dependencies": { "next": "16.4.3", "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3", "tailwindcss": "4.3.3",
    "typescript": "^5.9.0", "@types/node": "^22.0.0", "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0", "eslint": "9.39.5", "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0"
  }
}
